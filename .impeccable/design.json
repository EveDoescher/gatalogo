      "css": ".ds-notebook{background:#B89A79;border:1.5px solid #93765F;border-radius:15px;padding:3px 4px 7px;box-shadow:0 5px 12px rgba(146,119,84,.133333)}.ds-page{position:relative;background:#FFF8E7;border:1px solid #DDCCAD;border-radius:11px;padding:20px 16px 20px 26px;color:#382923;font:500 14px/1.3 Nunito,sans-serif}.ds-page strong{font:600 22px Fredoka,sans-serif}.ds-page p{margin:12px 0 0}.ds-binding{position:absolute;left:2px;top:28px;width:19px;height:8px;border:1.7px solid #93765F;background:#E7C89F;border-radius:7px;pointer-events:none}"
